# Copy to .env and fill in. Every VITE_ variable the code reads is compiled
# into the app bundle, so nothing here may be secret.

# IGDB credentials (Twitch client ID / secret) live ONLY in Supabase secrets
# (TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET), used by the igdb-proxy Edge Function.
# Never add them here.

# IGDB proxy: the deployed igdb-proxy Supabase Edge Function URL.
# All IGDB traffic goes through it; without it, game data does not load.
VITE_IGDB_PROXY_URL=

# Public web origin for links that leave the app (password-reset redirect).
# Must be allow-listed in Supabase -> Authentication -> URL Configuration.
# VITE_PUBLIC_APP_URL=

# Supabase: Project Settings -> API (the anon key is public by design).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Outward-facing links (read only by src/config/site.js) -----------------
# Each is optional. A feature whose value is missing is hidden, never faked:
#   no VITE_SITE_URL      -> share actions send text without a link, and the
#                            Privacy Policy / Terms rows are hidden
#   no VITE_SUPPORT_EMAIL -> "Send feedback" is hidden
#   no VITE_APP_STORE_ID  -> "Rate the app" is hidden
#   no VITE_BUILD_NUMBER  -> the "(build N)" suffix is hidden

# Origin of the static site deployed from /web (see web/README.md),
# e.g. https://yourdomain.com — no trailing slash, no path.
# VITE_SITE_URL=

# Address behind Settings -> Help & about -> Send feedback.
# VITE_SUPPORT_EMAIL=

# Numeric App Store ID, available once the app exists in App Store Connect.
# VITE_APP_STORE_ID=

# CFBundleVersion of the build being shipped.
# VITE_BUILD_NUMBER=
